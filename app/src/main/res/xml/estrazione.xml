<?xml version="1.0" encoding="utf-8"?>
<!-- (10/11/2026) Le chiavi API dell'assistente AI non vanno nel backup ne' nel passaggio a un altro telefono (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="portachiavi_ai.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="portachiavi_ai.xml" />
    </device-transfer>
</data-extraction-rules>
